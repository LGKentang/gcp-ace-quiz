# Copy to .env and fill in. Never commit .env.

# --- Google sign-in -------------------------------------------------------
# Google Cloud console > APIs & Services > Credentials > Create credentials >
# OAuth client ID > "Web application". Under "Authorized JavaScript origins"
# add your public URL (e.g. https://ace.example.com). No redirect URI needed.
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Comma-separated Google emails that are always admins (and always allowed in).
ADMIN_EMAILS=you@gmail.com

# Who can join:
#   approval = any Google account can request access; an admin approves it (default)
#   open     = any Google account gets in immediately
#   invite   = only emails an admin has added can sign in
REGISTRATION_MODE=approval

# Optional: only allow these email domains (comma-separated), e.g. gmail.com,mycompany.com
ALLOWED_EMAIL_DOMAINS=

# Your public URL (no trailing slash). Used to reject cross-site requests.
PUBLIC_ORIGIN=https://ace.example.com

# --- Sessions ---------------------------------------------------------------
SESSION_DAYS=30
# Keep true behind Cloudflare (HTTPS). Set false only for plain-http local testing.
COOKIE_SECURE=true

# --- Abuse protection -------------------------------------------------------
# Per-IP and per-user rate limits (sign-ins, sign-ups, saves, API calls). Keep on.
RATE_LIMITS_ENABLED=true
# Max accounts waiting for approval before new sign-ups are paused.
MAX_PENDING_USERS=200
# Header with the visitor's real IP. cloudflared sets CF-Connecting-IP. If you ever
# publish the app port directly (not only via the tunnel), set this to empty.
TRUSTED_IP_HEADER=cf-connecting-ip

# --- Cloudflare Tunnel ------------------------------------------------------
# Cloudflare dashboard > Zero Trust > Networks > Tunnels > Create a tunnel >
# Cloudflared > copy the token from the "docker run ... --token <TOKEN>" command.
CLOUDFLARE_TUNNEL_TOKEN=
